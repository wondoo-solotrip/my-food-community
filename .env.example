# Supabase — 서버 전용 (NEXT_PUBLIC_ 접두사 금지: 클라이언트에 노출하지 않는다)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# service-role 시크릿 키 — RLS를 우회한다. 세션 없는 서버 간 BFF(포트원 결제 웹훅
# /api/payments/webhook)의 원장 기록에 필요하다. 대시보드(Settings > API Keys)에서 발급한다.
SUPABASE_SECRET_KEY=

# 스토리지 공개 URL 베이스 (버킷/파일 경로는 코드에서 조립한다)
SUPABASE_STORAGE_URL=https://<project-ref>.supabase.co/storage/v1/object/public

# 네이버 지역 검색 API(네이버 API 허브) — 서버 전용 (장소 검색 BFF `/api/places/search`가 사용)
# https://console.ncloud.com 에서 네이버 API 허브의 "검색" 상품을 신청해 Client ID/Secret을
# 발급받는다. 독스: https://api.ncloud-docs.com/docs/naver-api-hub-search-local
# 키가 없으면 장소 검색은 비활성화되고 장소명 직접 입력만 동작한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 지도 JavaScript API(NCP Maps) — 클라이언트 키 (장소 등록 화면의 지도가 사용)
# https://console.ncloud.com 에서 Maps > Application 등록 후 Client ID(ncpKeyId)를 발급받고,
# 콘솔의 "서비스 환경(Web)"에 사이트 도메인(localhost 포함)을 등록해야 한다.
# 지도 SDK는 브라우저에서 로드되므로 NEXT_PUBLIC_ 접두사가 필요하다 — 도메인 제한으로
# 보호되는 공개용 키라 서버 전용 키 규칙(Supabase·검색 API)과는 별개다.
# 키가 없으면 장소 등록 지도는 정적 목업 이미지로 대체된다.
NEXT_PUBLIC_NCP_MAP_CLIENT_ID=

# 네이버 Reverse Geocoding API(NCP Maps) — 서버 전용 (주소 조회 BFF `/api/reverse-geocode`가 사용)
# 위 Maps Application과 같은 애플리케이션의 인증 정보다 — Client ID는
# NEXT_PUBLIC_NCP_MAP_CLIENT_ID와 같은 값(ncpKeyId)이고, Secret은 콘솔의
# Application 상세에서 확인한다. Secret이 섞이므로 서버 전용으로만 쓴다
# (NEXT_PUBLIC_ 금지). 독스: https://api.ncloud-docs.com/docs/en/application-maps-reversegeocoding
# 키가 없으면 지도 이동 시 주소 조회(리버스 지오코딩)가 비활성화된다.
NCP_MAP_CLIENT_ID=
NCP_MAP_CLIENT_SECRET=

# 포트원(PortOne) V2 결제 — 배너(모임) 상세 결제가 사용. 규칙: rules/payment.md (SSOT)
# Store ID·Channel Key는 결제창(브라우저 SDK) 호출에 필요한 공개 식별자라 NEXT_PUBLIC_로
# 노출한다 — 시크릿이 아니다. https://admin.portone.io 상점 > 결제 연동에서 확인한다.
NEXT_PUBLIC_PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 포트원 V2 API Secret — 서버 전용(NEXT_PUBLIC_ 금지). 결제 검증 BFF(/api/payments/complete,
# /api/payments/webhook)가 결제 단건 조회에 사용한다. 콘솔 > 결제 연동 > 식별코드·API Keys에서
# V2 API Secret을 발급받아 설정한다. 없으면 결제 검증(원장 기록)이 실패한다.
PORTONE_V2_API_SECRET=

# 포트원 V2 Webhook Secret — 서버 전용(NEXT_PUBLIC_ 금지). 결제 웹훅 BFF(/api/payments/webhook)가
# 시그니처 검증(@portone/server-sdk Webhook.verify)에 사용한다. 콘솔 > 결제 연동 > 연동 관리 >
# 결제알림(Webhook) 관리에서 웹훅 버전 [결제모듈 V2]를 선택해 발급한다. 같은 화면에서 웹훅
# URL(https://<도메인>/api/payments/webhook, HTTPS만 허용)도 등록해야 한다.
# 없으면 웹훅 수신이 전부 거절된다.
PORTONE_V2_WEBHOOK_SECRET=
